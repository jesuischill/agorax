app.get("/api/posts", auth, (req, res) => {
  const posts = read(FILES.posts)
    .sort(
      (a, b) =>
        new Date(b.createdAt) -
        new Date(a.createdAt)
    );

  res.json(posts.slice(0, 200));
});

app.post(
  "/api/posts",
  auth,
  upload.single("attachment"),
  (req, res) => {
    const text = String(req.body.text || "").trim();

    let attachment = null;

    if (req.file) {
      attachment = {
        name: req.file.originalname,
        url: "/uploads/" + req.file.filename,
        type: req.file.mimetype,
        size: req.file.size
      };
    }

    if (!text && !attachment) {
      return res.status(400).json({
        error: "Publication vide."
      });
    }

    const posts = read(FILES.posts);

    const post = {
      id:
        Date.now().toString(36) +
        Math.random().toString(36).slice(2, 7),
      from: req.user.username,
      text,
      attachment,
      likes: [],
      comments: [],
      createdAt: new Date().toISOString()
    };

    posts.push(post);

    write(FILES.posts, posts);

    res.json(post);
  }
);

app.post("/api/posts/:id/like", auth, (req, res) => {
  const posts = read(FILES.posts);

  const post = posts.find(
    p => p.id === req.params.id
  );

  if (!post) {
    return res.status(404).json({
      error: "Publication introuvable."
    });
  }

  post.likes = Array.isArray(post.likes)
    ? post.likes
    : [];

  const index = post.likes.indexOf(
    req.user.username
  );

  if (index >= 0) {
    post.likes.splice(index, 1);
  } else {
    post.likes.push(req.user.username);
  }

  write(FILES.posts, posts);

  res.json({
    likes: post.likes.length,
    liked: post.likes.includes(req.user.username)
  });
});

app.post("/api/posts/:id/comments", auth, (req, res) => {
  const posts = read(FILES.posts);

  const post = posts.find(
    p => p.id === req.params.id
  );

  if (!post) {
    return res.status(404).json({
      error: "Publication introuvable."
    });
  }

  const text = String(req.body.text || "").trim();

  if (!text) {
    return res.status(400).json({
      error: "Commentaire vide."
    });
  }

  post.comments = Array.isArray(post.comments)
    ? post.comments
    : [];

  const comment = {
    id: Date.now().toString(36),
    from: req.user.username,
    text,
    createdAt: new Date().toISOString()
  };

  post.comments.push(comment);

  write(FILES.posts, posts);

  res.json(comment);
});


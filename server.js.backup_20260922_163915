const express = require("express");
const session = require("express-session");
const bcrypt = require("bcryptjs");
const multer = require("multer");
const path = require("path");
const fs = require("fs");
const http = require("http");
const { Server } = require("socket.io");

const app = express();
const server = http.createServer(app);
const io = new Server(server);

const PORT = 3000;
const ROOT = __dirname;
const DATA = path.join(ROOT, "data");
const PUBLIC = path.join(ROOT, "public");
const UPLOADS = path.join(ROOT, "uploads");

for (const dir of [DATA, PUBLIC, UPLOADS]) {
  fs.mkdirSync(dir, { recursive: true });
}

const FILES = {
  users: path.join(DATA, "users.json"),
  messages: path.join(DATA, "messages.json"),
  posts: path.join(DATA, "posts.json"),
  stories: path.join(DATA, "stories.json"),
  rooms: path.join(DATA, "rooms.json"),
  notifications: path.join(DATA, "notifications.json")
};

for (const file of Object.values(FILES)) {
  if (!fs.existsSync(file)) fs.writeFileSync(file, "[]");
}

function read(file) {
  try {
    const value = JSON.parse(fs.readFileSync(file, "utf8"));
    return Array.isArray(value) ? value : [];
  } catch {
    return [];
  }
}

function write(file, value) {
  fs.writeFileSync(file, JSON.stringify(value, null, 2));
}

function safeUser(user) {
  if (!user) return null;

  return {
    username: user.username,
    email: user.email,
    age: user.age,
    bio: user.bio || "",
    avatar: user.avatar || "",
    banner: user.banner || "",
    followers: Array.isArray(user.followers) ? user.followers : [],
    following: Array.isArray(user.following) ? user.following : [],
    createdAt: user.createdAt
  };
}

function getUser(req) {
  if (!req.session?.username) return null;

  return read(FILES.users).find(
    u => u.username === req.session.username
  );
}

function auth(req, res, next) {
  const user = getUser(req);

  if (!user) {
    return res.status(401).json({
      error: "Non connecté."
    });
  }

  req.user = user;
  next();
}

app.use(express.json({ limit: "20mb" }));
app.use(express.urlencoded({ extended: true }));

const sessionMiddleware = session({
  secret: "veyra-session-secret",
  resave: false,
  saveUninitialized: false,
  cookie: {
    maxAge: 1000 * 60 * 60 * 24 * 30,
    httpOnly: true,
    sameSite: "lax"
  }
});

app.use(sessionMiddleware);

app.use("/uploads", express.static(UPLOADS));
app.use(express.static(PUBLIC));

const storage = multer.diskStorage({
  destination: (_, __, cb) => cb(null, UPLOADS),
  filename: (_, file, cb) => {
    const ext = path.extname(file.originalname || "").toLowerCase();

    const name =
      Date.now() +
      "-" +
      Math.random().toString(36).slice(2, 10) +
      ext;

    cb(null, name);
  }
});

const upload = multer({
  storage,
  limits: {
    fileSize: 20 * 1024 * 1024
  }
});

/* =========================
   AUTH
========================= */

app.get("/api/auth/me", (req, res) => {
  const user = getUser(req);

  res.json({
    authenticated: !!user,
    user: safeUser(user)
  });
});

app.post("/api/auth/register", (req, res) => {
  const users = read(FILES.users);

  const username = String(req.body.username || "").trim();
  const email = String(req.body.email || "").trim().toLowerCase();
  const password = String(req.body.password || "");
  const age = Number(req.body.age);

  if (!/^[a-zA-Z0-9_.-]{3,24}$/.test(username)) {
    return res.status(400).json({
      error: "Le pseudo doit contenir 3 à 24 caractères."
    });
  }

  if (!email.includes("@")) {
    return res.status(400).json({
      error: "Email invalide."
    });
  }

  if (password.length < 6) {
    return res.status(400).json({
      error: "Le mot de passe doit contenir au moins 6 caractères."
    });
  }

  if (!Number.isInteger(age) || age < 13 || age > 120) {
    return res.status(400).json({
      error: "Âge invalide."
    });
  }

  if (
    users.some(
      u => String(u.username).toLowerCase() === username.toLowerCase()
    )
  ) {
    return res.status(409).json({
      error: "Ce pseudo est déjà utilisé."
    });
  }

  if (
    users.some(
      u => String(u.email).toLowerCase() === email
    )
  ) {
    return res.status(409).json({
      error: "Cet email est déjà utilisé."
    });
  }

  const user = {
    username,
    email,
    age,
    passwordHash: bcrypt.hashSync(password, 12),
    bio: "",
    avatar: "",
    banner: "",
    followers: [],
    following: [],
    createdAt: new Date().toISOString()
  };

  users.push(user);
  write(FILES.users, users);

  req.session.username = username;

  req.session.save(() => {
    res.json({
      ok: true,
      user: safeUser(user)
    });
  });
});

app.post("/api/auth/login", (req, res) => {
  const users = read(FILES.users);

  const identifier = String(
    req.body.identifier ||
    req.body.username ||
    req.body.email ||
    ""
  ).trim();

  const password = String(req.body.password || "");

  const user = users.find(u =>
    String(u.username).toLowerCase() === identifier.toLowerCase() ||
    String(u.email).toLowerCase() === identifier.toLowerCase()
  );

  if (
    !user ||
    !user.passwordHash ||
    !bcrypt.compareSync(password, user.passwordHash)
  ) {
    return res.status(401).json({
      error: "Identifiants incorrects."
    });
  }

  req.session.username = user.username;

  req.session.save(() => {
    res.json({
      ok: true,
      user: safeUser(user)
    });
  });
});

app.post("/api/auth/logout", (req, res) => {
  req.session.destroy(() => {
    res.json({ ok: true });
  });
});


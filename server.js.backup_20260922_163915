app.get(
  "/api/messages/:username",
  auth,
  (req, res) => {
    const username = req.params.username;

    const messages = read(FILES.messages)
      .filter(m =>
        m.type === "private" &&
        (
          (
            m.from === req.user.username &&
            m.to === username
          ) ||
          (
            m.from === username &&
            m.to === req.user.username
          )
        )
      )
      .sort(
        (a, b) =>
          new Date(a.createdAt) -
          new Date(b.createdAt)
      );

    res.json(messages.slice(-500));
  }
);

app.get(
  "/api/messages/conversations",
  auth,
  (req, res) => {
    const messages = read(FILES.messages);

    const map = new Map();

    for (const m of messages) {
      if (m.type !== "private") continue;

      if (
        m.from !== req.user.username &&
        m.to !== req.user.username
      ) {
        continue;
      }

      const other =
        m.from === req.user.username
          ? m.to
          : m.from;

      const old = map.get(other);

      if (
        !old ||
        new Date(m.createdAt) >
          new Date(old.createdAt)
      ) {
        map.set(other, m);
      }
    }

    const result = [...map.entries()]
      .map(([username, message]) => ({
        username,
        lastMessage: message,
        createdAt: message.createdAt
      }))
      .sort(
        (a, b) =>
          new Date(b.createdAt) -
          new Date(a.createdAt)
      );

    res.json(result);
  }
);


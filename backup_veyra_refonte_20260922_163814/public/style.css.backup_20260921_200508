* {
  box-sizing: border-box;
}

:root {
  --bg: #050507;
  --panel: #0d0d11;
  --panel2: #14141a;
  --panel3: #1b1b22;
  --border: rgba(255,255,255,.08);
  --text: #f7f7f8;
  --muted: #9999a5;
  --soft: #70707b;
  --accent: #8b5cf6;
  --accent2: #a78bfa;
  --danger: #ff5577;
  --green: #35d07f;
  --radius: 18px;
}

html,
body {
  margin: 0;
  width: 100%;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  overflow-x: hidden;
}

button,
input,
textarea {
  font: inherit;
}

button {
  border: 0;
  color: inherit;
  cursor: pointer;
}

button:active {
  transform: scale(.98);
}

.hidden {
  display: none !important;
}

#app {
  min-height: 100vh;
}


/* ================================================= */
/* SIDEBAR */
/* ================================================= */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 250px;
  border-right: 1px solid var(--border);
  background: rgba(5,5,7,.96);
  display: flex;
  flex-direction: column;
  padding: 25px 16px;
  z-index: 30;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px 30px;
  font-size: 23px;
  font-weight: 800;
}

.brand-logo {
  width: 38px;
  height: 38px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg,#7c3aed,#c084fc);
  color: white;
  font-weight: 900;
  box-shadow: 0 8px 30px rgba(139,92,246,.25);
}

.main-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 14px;
  border-radius: 13px;
  background: transparent;
  color: var(--muted);
  text-align: left;
  transition: .2s;
}

.nav-item:hover {
  background: rgba(255,255,255,.05);
  color: white;
}

.nav-item.active {
  background: rgba(139,92,246,.15);
  color: white;
}

.nav-icon {
  width: 25px;
  text-align: center;
  font-size: 20px;
}

.nav-badge {
  margin-left: auto;
  min-width: 20px;
  height: 20px;
  border-radius: 99px;
  display: grid;
  place-items: center;
  padding: 0 6px;
  font-size: 11px;
  background: var(--accent);
  color: white;
}

.create-button {
  margin-top: 25px;
  width: 100%;
  padding: 14px;
  border-radius: 14px;
  background: linear-gradient(135deg,#7c3aed,#a855f7);
  font-weight: 750;
  display: flex;
  justify-content: center;
  gap: 9px;
  box-shadow: 0 12px 30px rgba(124,58,237,.22);
}

.sidebar-bottom {
  margin-top: auto;
}

.logout {
  color: #a4a4ad;
}


/* ================================================= */
/* MAIN */
/* ================================================= */

.main {
  margin-left: 250px;
  min-height: 100vh;
}

.topbar {
  height: 72px;
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(5,5,7,.82);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30px;
}

.top-search {
  width: min(520px,100%);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 16px;
  background: var(--panel2);
  border: 1px solid var(--border);
  border-radius: 14px;
}

.top-search input {
  flex: 1;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
}

.top-search input::placeholder {
  color: var(--soft);
}

.top-actions {
  position: absolute;
  right: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-button,
.avatar-button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--panel2);
  border: 1px solid var(--border);
}

.avatar-button {
  overflow: hidden;
  padding: 0;
}

.avatar-button img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mobile-brand {
  display: none;
}


/* ================================================= */
/* VIEWS */
/* ================================================= */

.view {
  display: none;
  padding: 30px;
  max-width: 1450px;
  margin: auto;
}

.active-view {
  display: block;
}

.home-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 310px;
  gap: 25px;
  max-width: 1150px;
  margin: auto;
}

.feed-column {
  min-width: 0;
}


/* ================================================= */
/* STORIES */
/* ================================================= */

.stories-panel,
.composer,
.quick-profile,
.quick-messages {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.section-title-row h2,
.section-title-row h3 {
  margin: 0;
}

.section-title-row span,
.page-header span {
  color: var(--muted);
  font-size: 13px;
}

.stories {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding-top: 20px;
  scrollbar-width: none;
}

.stories::-webkit-scrollbar {
  display: none;
}

.story {
  min-width: 105px;
  height: 155px;
  border-radius: 17px;
  overflow: hidden;
  position: relative;
  background:
    linear-gradient(145deg,#312e81,#7c3aed,#ec4899);
  border: 1px solid var(--border);
  cursor: pointer;
}

.story::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    transparent 35%,
    rgba(0,0,0,.75)
  );
}

.story-avatar {
  position: absolute;
  top: 9px;
  left: 9px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid white;
  z-index: 2;
}

.story-name {
  position: absolute;
  bottom: 10px;
  left: 10px;
  right: 8px;
  z-index: 3;
  font-size: 12px;
  font-weight: 700;
}

.add-story {
  background: var(--panel2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
}

.add-story span {
  font-size: 28px;
}

.small-button {
  background: var(--panel2);
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 10px;
}


/* ================================================= */
/* COMPOSER */
/* ================================================= */

.composer {
  margin-top: 18px;
}

.composer-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar {
  width: 43px;
  height: 43px;
  border-radius: 50%;
  object-fit: cover;
  background: var(--panel3);
}

.composer-placeholder {
  flex: 1;
  text-align: left;
  padding: 13px 16px;
  border-radius: 13px;
  background: var(--panel2);
  color: var(--muted);
}

.composer-actions {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  border-top: 1px solid var(--border);
  padding-top: 14px;
}

.composer-actions button {
  flex: 1;
  background: transparent;
  color: var(--muted);
  padding: 8px;
  border-radius: 10px;
}

.composer-actions button:hover {
  background: rgba(255,255,255,.05);
  color: white;
}


/* ================================================= */
/* FEED */
/* ================================================= */

.feed-heading {
  margin: 25px 0 14px;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.post {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.post-header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 17px;
}

.post-header img {
  width: 42px;
  height: 42px;
  object-fit: cover;
  border-radius: 50%;
}

.post-user {
  display: flex;
  flex-direction: column;
}

.post-user strong {
  font-size: 14px;
}

.post-user span {
  color: var(--muted);
  font-size: 12px;
}

.post-content {
  padding: 0 17px 15px;
  white-space: pre-wrap;
  line-height: 1.55;
}

.post-image {
  width: 100%;
  max-height: 600px;
  object-fit: cover;
  display: block;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 12px 15px;
  border-top: 1px solid var(--border);
}

.post-actions button {
  background: transparent;
  padding: 8px 10px;
  color: var(--muted);
  border-radius: 10px;
}

.post-actions button:hover {
  background: var(--panel2);
  color: white;
}

.like-active {
  color: #ff4f83 !important;
}


/* ================================================= */
/* RIGHT COLUMN */
/* ================================================= */

.quick-profile-head {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 18px;
}

.large-avatar {
  width: 55px;
  height: 55px;
  border-radius: 50%;
  object-fit: cover;
}

.quick-profile-head strong,
.quick-profile-head span {
  display: block;
}

.quick-profile-head span {
  color: var(--muted);
  font-size: 13px;
}

.outline-button {
  padding: 10px 14px;
  border: 1px solid var(--border);
  background: transparent;
  border-radius: 11px;
  color: white;
}

.full {
  width: 100%;
}

.quick-messages {
  margin-top: 17px;
}


/* ================================================= */
/* MESSAGES */
/* ================================================= */

.messages-layout {
  height: calc(100vh - 132px);
  max-width: 1250px;
  margin: auto;
  display: grid;
  grid-template-columns: 330px minmax(0,1fr);
  overflow: hidden;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.conversation-list {
  border-right: 1px solid var(--border);
  overflow-y: auto;
}

.messages-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
}

.messages-header h1 {
  margin: 0 0 5px;
  font-size: 22px;
}

.messages-header span {
  color: var(--muted);
  font-size: 12px;
}

.round-button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--accent);
}

.conversation-search {
  margin: 0 15px 12px;
  display: flex;
  gap: 8px;
  align-items: center;
  padding: 10px 12px;
  background: var(--panel2);
  border-radius: 11px;
}

.conversation-search input {
  width: 100%;
  background: transparent;
  color: white;
  border: 0;
  outline: 0;
}

.conversation {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 15px;
  background: transparent;
  text-align: left;
  border-left: 3px solid transparent;
}

.conversation:hover,
.conversation.active {
  background: rgba(139,92,246,.10);
}

.conversation.active {
  border-left-color: var(--accent);
}

.conversation-avatar {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 50%;
  object-fit: cover;
  background: var(--panel3);
  display: grid;
  place-items: center;
  overflow: hidden;
}

.conversation-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.public-avatar {
  background: linear-gradient(135deg,#312e81,#7c3aed);
}

.conversation-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.conversation-info strong,
.conversation-info span {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.conversation-info span {
  color: var(--muted);
  font-size: 12px;
}

.online-dot {
  margin-left: auto;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
}

.chat-window {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.chat-header {
  height: 75px;
  flex: 0 0 75px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  border-bottom: 1px solid var(--border);
}

.chat-person {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chat-person strong,
.chat-person span {
  display: block;
}

.chat-person span {
  color: var(--muted);
  font-size: 12px;
  margin-top: 3px;
}

.chat-avatar {
  width: 43px;
  height: 43px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--panel2);
}

.chat-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.chat-header-actions {
  display: flex;
  gap: 5px;
}

.chat-header-actions button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: transparent;
}

.chat-header-actions button:hover {
  background: var(--panel2);
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.chat-day {
  text-align: center;
  color: var(--soft);
  font-size: 11px;
  margin: 10px;
}

.message-row {
  display: flex;
  width: 100%;
}

.message-row.me {
  justify-content: flex-end;
}

.message-row.them {
  justify-content: flex-start;
}

.message-bubble {
  max-width: min(70%,550px);
  padding: 10px 13px;
  border-radius: 16px;
  background: var(--panel2);
  border: 1px solid var(--border);
  line-height: 1.45;
  word-break: break-word;
}

.message-row.me .message-bubble {
  background: linear-gradient(135deg,#6d28d9,#8b5cf6);
  border-color: transparent;
}

.message-meta {
  font-size: 10px;
  opacity: .55;
  margin-top: 4px;
}

.message-sender {
  font-size: 10px;
  color: var(--accent2);
  margin-bottom: 4px;
}

.typing-indicator {
  padding: 0 22px 8px;
  color: var(--muted);
  font-size: 12px;
}

.message-composer {
  min-height: 70px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 15px;
  border-top: 1px solid var(--border);
}

.message-composer input {
  flex: 1;
  border: 0;
  outline: 0;
  color: white;
  background: var(--panel2);
  padding: 12px 14px;
  border-radius: 14px;
}

.composer-icon {
  width: 39px;
  height: 39px;
  border-radius: 50%;
  background: transparent;
  color: var(--muted);
}

.composer-icon:hover {
  background: var(--panel2);
}

.send-button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--accent);
}


/* ================================================= */
/* PAGES */
/* ================================================= */

.page-header {
  max-width: 900px;
  margin: 0 auto 25px;
}

.page-header h1 {
  margin: 0 0 6px;
}

.search-results,
.notifications,
.profile-page {
  max-width: 900px;
  margin: auto;
}

.search-user {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
  margin-bottom: 8px;
}

.search-user img {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 50%;
}

.search-user-info {
  flex: 1;
}

.search-user-info strong,
.search-user-info span {
  display: block;
}

.search-user-info span {
  color: var(--muted);
  font-size: 12px;
}

.text-button {
  background: transparent;
  color: var(--accent2);
}

.notification {
  padding: 15px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  margin-bottom: 8px;
}

.profile-cover {
  height: 210px;
  border-radius: 20px;
  background: linear-gradient(135deg,#1e1b4b,#7c3aed,#db2777);
}

.profile-info {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  margin-top: -45px;
  position: relative;
  padding: 0 25px 25px;
}

.profile-main-avatar {
  width: 95px;
  height: 95px;
  object-fit: cover;
  border-radius: 50%;
  border: 5px solid var(--panel);
  margin-top: -45px;
}

.profile-name {
  font-size: 25px;
  font-weight: 800;
  margin-top: 10px;
}

.profile-handle {
  color: var(--muted);
}

.profile-bio {
  margin-top: 15px;
  line-height: 1.5;
}

.profile-stats {
  display: flex;
  gap: 30px;
  margin-top: 20px;
}

.profile-stat strong,
.profile-stat span {
  display: block;
}

.profile-stat span {
  color: var(--muted);
  font-size: 12px;
}


/* ================================================= */
/* MODALS */
/* ================================================= */

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 20px;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.72);
  backdrop-filter: blur(7px);
}

.modal-card {
  position: relative;
  width: min(500px,100%);
  background: #101014;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 25px;
  box-shadow: 0 30px 100px rgba(0,0,0,.6);
}

.modal-card h2 {
  margin-top: 0;
}

.modal-card p {
  color: var(--muted);
}

.modal-close {
  position: absolute;
  right: 15px;
  top: 15px;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: var(--panel2);
  font-size: 22px;
}

.create-options {
  display: grid;
  gap: 10px;
  margin-top: 20px;
}

.create-options button {
  display: grid;
  grid-template-columns: 50px 1fr;
  text-align: left;
  align-items: center;
  padding: 15px;
  background: var(--panel2);
  border: 1px solid var(--border);
  border-radius: 14px;
}

.create-options button span {
  grid-row: 1 / span 2;
  font-size: 27px;
}

.create-options small {
  color: var(--muted);
}

.post-modal textarea {
  width: 100%;
  min-height: 170px;
  resize: vertical;
  padding: 15px;
  background: var(--panel2);
  border: 1px solid var(--border);
  color: white;
  border-radius: 13px;
  outline: none;
  margin: 10px 0;
}

.post-modal input[type=file] {
  width: 100%;
  margin: 8px 0 15px;
}

.primary-button {
  width: 100%;
  padding: 13px;
  border-radius: 12px;
  background: var(--accent);
  color: white;
  font-weight: 700;
}


/* ================================================= */
/* EMPTY */
/* ================================================= */

.empty-state {
  text-align: center;
  padding: 80px 20px;
  color: var(--muted);
}

.empty-state div {
  font-size: 45px;
}

.empty-state h2 {
  color: white;
}


/* ================================================= */
/* TOAST */
/* ================================================= */

.toast {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  padding: 12px 17px;
  border-radius: 13px;
  background: #202027;
  border: 1px solid var(--border);
  box-shadow: 0 15px 40px rgba(0,0,0,.4);
  z-index: 200;
}


/* ================================================= */
/* MOBILE */
/* ================================================= */

.mobile-nav {
  display: none;
}

@media (max-width: 1000px) {

  .sidebar {
    width: 78px;
    padding: 20px 10px;
  }

  .sidebar .brand span,
  .sidebar .nav-item span:not(.nav-icon),
  .sidebar .create-button span:not(:first-child) {
    display: none;
  }

  .sidebar .brand {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .nav-item {
    justify-content: center;
    padding: 13px 5px;
  }

  .create-button {
    justify-content: center;
  }

  .main {
    margin-left: 78px;
  }

  .right-column {
    display: none;
  }

  .home-layout {
    display: block;
    max-width: 720px;
  }
}

@media (max-width: 720px) {

  .sidebar {
    display: none;
  }

  .main {
    margin-left: 0;
    padding-bottom: 70px;
  }

  .topbar {
    height: 62px;
    padding: 0 12px;
    justify-content: flex-start;
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mobile-brand .brand-logo {
    width: 32px;
    height: 32px;
  }

  .top-search {
    display: none;
  }

  .top-actions {
    right: 10px;
  }

  .top-actions .icon-button {
    display: none;
  }

  .view {
    padding: 14px 10px;
  }

  .stories-panel,
  .composer {
    border-radius: 14px;
  }

  .messages-layout {
    height: calc(100vh - 90px);
    display: block;
    border-radius: 14px;
  }

  .conversation-list {
    display: none;
  }

  .chat-window {
    height: 100%;
  }

  .message-bubble {
    max-width: 82%;
  }

  .mobile-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 65px;
    z-index: 50;
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(10,10,13,.96);
    border-top: 1px solid var(--border);
    backdrop-filter: blur(20px);
  }

  .mobile-nav button {
    background: transparent;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .mobile-nav span {
    font-size: 20px;
  }

  .mobile-nav small {
    font-size: 9px;
  }

  .mobile-create {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--accent);
    color: white;
  }

  .profile-cover {
    height: 150px;
  }

  .profile-info {
    padding: 0 15px 20px;
  }
}

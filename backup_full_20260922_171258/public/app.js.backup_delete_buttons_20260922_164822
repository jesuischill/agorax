function appendMessage(container, message) {
  const mine =
    message.from === me.username;

  const row =
    document.createElement("div");

  row.className =
    "message-row " +
    (mine ? "mine" : "");

  row.innerHTML = `
    <div class="message-author">
      @${escapeHtml(message.from)}
    </div>

    <div class="message-bubble">

      ${
        message.text
          ? `
            <div class="message-text">
              ${escapeHtml(message.text)}
            </div>
          `
          : ""
      }

      ${
        message.attachment
          ? attachmentHtml(
              message.attachment
            )
          : ""
      }

      <div class="message-time">
        ${formatDate(message.createdAt)}
      </div>

    </div>
  `;

  container.appendChild(row);
}

function attachmentHtml(file) {
  const image =
    file.type &&
    file.type.startsWith("image/");

  if (image) {
    return `
      <a
        class="attachment-image"
        href="${escapeHtml(file.url)}"
        target="_blank"
      >
        <img
          src="${escapeHtml(file.url)}"
          alt="${escapeHtml(file.name)}"
        >
      </a>
    `;
  }

  return `
    <a
      class="attachment-file"
      href="${escapeHtml(file.url)}"
      target="_blank"
    >
      📎 ${escapeHtml(file.name)}
    </a>
  `;
}

async function searchChatUsers() {
  const q =
    $("chatSearch").value.trim();

  if (!q) {
    $("chatSearchResults").innerHTML = "";
    return;
  }

  try {
    const users =
      await api(
        "/api/users/search?q=" +
        encodeURIComponent(q)
      );

    $("chatSearchResults").innerHTML =
      users.map(user => `
        <button
          class="user-result"
          onclick="openPrivate('${escapeHtml(user.username)}')"
        >

          <div class="avatar">
            ${avatarHtml(user.username, user.avatar)}
          </div>

          <div>
            <strong>
              @${escapeHtml(user.username)}
            </strong>
            <span>
              ${user.bio
                ? escapeHtml(user.bio)
                : "Utilisateur Veyra"}
            </span>
          </div>

        </button>
      `).join("");

  } catch (error) {
    toast(error.message);
  }
}

async function searchGlobal() {
  const q =
    $("globalSearch").value.trim();

  if (!q) {
    $("globalResults").innerHTML = "";
    return;
  }

  try {
    const users =
      await api(
        "/api/users/search?q=" +
        encodeURIComponent(q)
      );

    $("globalResults").innerHTML =
      users.map(user => `
        <button
          class="user-result big"
          onclick="openUserProfile('${escapeHtml(user.username)}')"
        >

          <div class="avatar">
            ${avatarHtml(user.username, user.avatar)}
          </div>

          <div>
            <strong>
              @${escapeHtml(user.username)}
            </strong>
            <span>
              ${escapeHtml(
                user.bio || "Profil Veyra"
              )}
            </span>
          </div>

        </button>
      `).join("");

  } catch (error) {
    toast(error.message);
  }
}

window.openUserProfile = async username => {
  try {
    const user =
      await api(
        "/api/users/" +
        encodeURIComponent(username)
      );

    $("profile").innerHTML =
      profileHtml(user, true);

    showPage("profile");

  } catch (error) {
    toast(error.message);
  }
};

async function loadProfile() {
  $("profile").innerHTML =
    profileHtml(me, false);
}

function profileHtml(user, other) {
  const following =
    Array.isArray(me.following) &&
    me.following.includes(
      user.username
    );

  return `
    <div class="profile-cover">

      <div class="profile-avatar">
        ${avatarHtml(user.username, user.avatar)}
      </div>

    </div>

    <div class="profile-content">

      <div class="profile-title">

        <div>

          <h1>
            @${escapeHtml(user.username)}
          </h1>

          <p>
            ${escapeHtml(
              user.bio || "Bienvenue sur Veyra."
            )}
          </p>

        </div>

        ${
          other
            ? `
              <button
                class="primary-small"
                onclick="followUser('${escapeHtml(user.username)}')"
              >
                ${following ? "Suivi" : "Suivre"}
              </button>
            `
            : `
              <button
                class="primary-small"
                onclick="logout()"
              >
                Déconnexion
              </button>
            `
        }

      </div>

      <div class="profile-stats">

        <div>
          <strong>
            ${user.followers?.length || 0}
          </strong>
          <span>abonnés</span>
        </div>

        <div>
          <strong>
            ${user.following?.length || 0}
          </strong>
          <span>abonnements</span>
        </div>

      </div>

      ${
        other
          ? `
            <button
              class="secondary-button"
              onclick="openPrivate('${escapeHtml(user.username)}')"
            >
              💬 Discuter
            </button>
          `
          : ""
      }

    </div>
  `;
}

window.followUser = async username => {
  try {
    const result =
      await api(
        "/api/users/" +
        encodeURIComponent(username) +
        "/follow",
        {
          method: "POST"
        }
      );

    toast(
      result.following
        ? "Tu suis maintenant @" + username
        : "Tu ne suis plus @" + username
    );

    if (result.user) {
      $("profile").innerHTML =
        profileHtml(result.user, true);
    }

  } catch (error) {
    toast(error.message);
  }
};

window.logout = async () => {
  await api("/api/auth/logout", {
    method: "POST"
  });

  location.href = "/login.html";
};

init();


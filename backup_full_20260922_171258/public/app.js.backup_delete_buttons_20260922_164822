async function loadConversations() {
  try {
    const conversations =
      await api(
        "/api/messages/conversations"
      );

    const container =
      $("conversations");

    container.innerHTML = "";

    if (!conversations.length) {
      container.innerHTML = `
        <div class="empty">
          <div class="empty-icon">▣</div>
          <h3>Aucune discussion</h3>
          <p>Recherche quelqu'un pour commencer.</p>
        </div>
      `;
      return;
    }

    for (const conversation of conversations) {
      const username =
        conversation.username;

      const user =
        await api(
          "/api/users/" +
          encodeURIComponent(username)
        ).catch(() => ({
          username
        }));

      container.insertAdjacentHTML(
        "beforeend",
        `
          <button
            class="conversation"
            onclick="openPrivate('${escapeHtml(username)}')"
          >

            <div class="avatar">
              ${avatarHtml(username, user.avatar)}
            </div>

            <div class="conversation-body">

              <div class="conversation-top">

                <strong>
                  @${escapeHtml(username)}
                </strong>

                <span>
                  ${formatDate(conversation.createdAt)}
                </span>

              </div>

              <p>
                ${escapeHtml(
                  conversation.lastMessage?.text ||
                  "📎 Fichier"
                )}
              </p>

            </div>

            ${
              presenceUsers.includes(username)
                ? `<span class="online-dot"></span>`
                : ""
            }

          </button>
        `
      );
    }

  } catch (error) {
    toast(error.message);
  }
}

window.openPrivate = async username => {
  currentPrivateUser = username;

  $("conversationView").classList.add("hidden");
  $("privateChat").classList.remove("hidden");

  $("privateName").textContent =
    "@" + username;

  $("privateAvatar").textContent =
    username.charAt(0).toUpperCase();

  updatePrivateStatus();

  const messages =
    await api(
      "/api/messages/" +
      encodeURIComponent(username)
    );

  $("privateMessages").innerHTML = "";

  messages.forEach(message => {
    appendMessage(
      $("privateMessages"),
      message
    );
  });

  $("privateMessages").scrollTop =
    $("privateMessages").scrollHeight;

  $("privateInput").focus();
};

function updatePrivateStatus() {
  if (!currentPrivateUser) return;

  const online =
    presenceUsers.includes(
      currentPrivateUser
    );

  $("privateStatus").textContent =
    online ? "en ligne" : "hors ligne";

  $("privateStatus").className =
    online ? "online-text" : "";
}

async function sendPrivate() {
  if (!currentPrivateUser) return;

  const input = $("privateInput");

  const text = input.value.trim();

  const file =
    $("privateFile").files[0];

  if (!text && !file) return;

  try {
    let attachment = null;

    if (file) {
      const form = new FormData();

      form.append("file", file);

      const uploaded =
        await api("/api/upload", {
          method: "POST",
          body: form
        });

      attachment = uploaded.file;
    }

    socket.emit("privateMessage", {
      to: currentPrivateUser,
      text,
      attachment
    });

    input.value = "";
    $("privateFile").value = "";

    socket.emit("typing", {
      to: currentPrivateUser,
      active: false
    });

  } catch (error) {
    toast(error.message);
  }
}


let me = null;
let socket = null;
let currentPrivateUser = null;
let currentRoom = null;
let presenceUsers = [];
let selectedPostFile = null;
let selectedStoryFile = null;

const $ = id => document.getElementById(id);

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function formatDate(date) {
  const d = new Date(date);

  return d.toLocaleString("fr-FR", {
    day: "2-digit",
    month: "2-digit",
    hour: "2-digit",
    minute: "2-digit"
  });
}

async function api(url, options = {}) {
  const response = await fetch(url, options);

  const data = await response
    .json()
    .catch(() => ({}));

  if (!response.ok) {
    throw new Error(
      data.error || "Une erreur est survenue."
    );
  }

  return data;
}

function toast(message) {
  $("toast").textContent = message;
  $("toast").classList.add("show");

  clearTimeout(toast.timer);

  toast.timer = setTimeout(() => {
    $("toast").classList.remove("show");
  }, 2600);
}

function showPage(page) {
  document.querySelectorAll(".page").forEach(p => {
    p.classList.remove("active");
  });

  const target = $("page-" + page);

  if (target) {
    target.classList.add("active");
  }

  document.querySelectorAll(".nav-item").forEach(btn => {
    btn.classList.toggle(
      "active",
      btn.dataset.page === page
    );
  });

  if (page === "home") {
    loadFeed();
    loadStories();
  }

  if (page === "stories") {
    loadStoriesFull();
  }

  if (page === "chat") {
    loadConversations();
  }

  if (page === "public") {
    loadPublic();
  }

  if (page === "profile") {
    loadProfile();
  }
}

function avatarHtml(username, avatar = "") {
  if (avatar) {
    return `
      <img
        class="avatar-img"
        src="${escapeHtml(avatar)}"
        alt=""
      >
    `;
  }

  return escapeHtml(
    String(username || "?")
      .charAt(0)
      .toUpperCase()
  );
}

async function init() {
  try {
    const auth = await api("/api/auth/me");

    if (!auth.authenticated) {
      location.href = "/login.html";
      return;
    }

    me = auth.user;

    updateUserInterface();

    socket = io();

    socket.on("connect", () => {
      socket.emit("joinPublic");
    });

    socket.on("presence", users => {
      presenceUsers = users || [];
      updatePrivateStatus();
    });

    socket.on("privateMessage", message => {
      if (
        currentPrivateUser &&
        (
          (
            message.from === me.username &&
            message.to === currentPrivateUser
          ) ||
          (
            message.from === currentPrivateUser &&
            message.to === me.username
          )
        )
      ) {
        appendMessage(
          $("privateMessages"),
          message
        );

        $("privateMessages").scrollTop =
          $("privateMessages").scrollHeight;
      }

      loadConversations();
    });

    socket.on("publicMessage", message => {
      if (
        document
          .querySelector("#page-public")
          .classList.contains("active")
      ) {
        appendMessage(
          $("publicMessages"),
          message
        );

        $("publicMessages").scrollTop =
          $("publicMessages").scrollHeight;
      }
    });

    socket.on("typing", data => {
      if (
        currentPrivateUser === data.from
      ) {
        $("typingPrivate").classList.toggle(
          "hidden",
          !data.active
        );
      }
    });

    setupNavigation();

    await loadFeed();
    await loadStories();

  } catch (error) {
    console.error(error);
    location.href = "/login.html";
  }
}

function updateUserInterface() {
  $("navAvatar").textContent =
    String(me.username || me.pseudo || me.user || "Utilisateur").charAt(0).toUpperCase();

  $("topProfile").textContent =
    String(me.username || me.pseudo || me.user || "Utilisateur").charAt(0).toUpperCase();

  $("composerAvatar").textContent =
    String(me.username || me.pseudo || me.user || "Utilisateur").charAt(0).toUpperCase();
}

function setupNavigation() {
  document.querySelectorAll("[data-page]").forEach(btn => {
    btn.addEventListener("click", () => {
      showPage(btn.dataset.page);
    });
  });

  $("topSearch").onclick = () => {
    showPage("search");
    $("globalSearch").focus();
  };

  $("topProfile").onclick = () => {
    showPage("profile");
  };

  $("composerButton").onclick = () => {
    $("postModal").classList.remove("hidden");
  };

  $("newPostTop").onclick = () => {
    $("postModal").classList.remove("hidden");
  };

  $("createStory").onclick = () => {
    $("storyModal").classList.remove("hidden");
  };

  $("openStories").onclick = () => {
    showPage("stories");
  };

  document
    .querySelectorAll("[data-close]")
    .forEach(btn => {
      btn.onclick = () => {
        $(btn.dataset.close).classList.add("hidden");
      };
    });

  $("composerFile").onclick = () => {
    $("composerFileInput").click();
  };

  $("composerFileInput").onchange = e => {
    if (e.target.files[0]) {
      selectedPostFile = e.target.files[0];
      $("postModal").classList.remove("hidden");
      $("postPreview").textContent =
        selectedPostFile.name;
    }
  };

  $("postFile").onchange = e => {
    selectedPostFile =
      e.target.files[0] || null;

    $("postPreview").textContent =
      selectedPostFile
        ? selectedPostFile.name
        : "";
  };

  $("storyFile").onchange = e => {
    selectedStoryFile =
      e.target.files[0] || null;

    $("storyPreview").textContent =
      selectedStoryFile
        ? selectedStoryFile.name
        : "";
  };

  $("publishPost").onclick = publishPost;
  $("publishStory").onclick = publishStory;

  $("newConversation").onclick = () => {
    showPage("search");
    $("globalSearch").focus();
  };

  $("closePrivate").onclick = () => {
    currentPrivateUser = null;
    $("privateChat").classList.add("hidden");
    $("conversationView").classList.remove("hidden");
  };

  $("privateSend").onclick = sendPrivate;

  $("privateInput").addEventListener(
    "keydown",
    e => {
      if (e.key === "Enter") {
        e.preventDefault();
        sendPrivate();
      }
    }
  );

  $("privateInput").addEventListener(
    "input",
    () => {
      if (!socket || !currentPrivateUser) return;

      socket.emit("typing", {
        to: currentPrivateUser,
        active:
          $("privateInput").value.length > 0
      });
    }
  );

  $("publicSend").onclick = sendPublic;

  $("publicInput").addEventListener(
    "keydown",
    e => {
      if (e.key === "Enter") {
        e.preventDefault();
        sendPublic();
      }
    }
  );

  $("chatSearch").addEventListener(
    "input",
    searchChatUsers
  );

  $("globalSearch").addEventListener(
    "input",
    searchGlobal
  );
}

async function loadFeed() {
  try {
    const posts = await api("/api/posts");

    $("feed").innerHTML = "";

    if (!posts.length) {
      $("feed").innerHTML = `
        <div class="empty">
          <div class="empty-icon">✦</div>
          <h3>Ton fil est vide</h3>
          <p>Publie quelque chose pour commencer.</p>
        </div>
      `;
      return;
    }

    posts.forEach(post => {
      $("feed").insertAdjacentHTML(
        "beforeend",
        postHtml(post)
      );
    });

  } catch (error) {
    toast(error.message);
  }
}

function postHtml(post) {
  const liked =
    Array.isArray(post.likes) &&
    post.likes.includes(me.username);

  const comments =
    Array.isArray(post.comments)
      ? post.comments
      : [];

  return `
    <article class="post-card">

      <div class="post-head">

        <div class="avatar">
          ${avatarHtml(post.from)}
        </div>

        <div>
          <strong>@${escapeHtml(post.from)}</strong>
          <span>${formatDate(post.createdAt)}</span>
        </div>

      </div>

      ${
        post.text
          ? `
            <div class="post-text">
              ${escapeHtml(post.text)}
            </div>
          `
          : ""
      }

      ${
        post.attachment
          ? attachmentHtml(post.attachment)
          : ""
      }

      <div class="post-actions">

        <button
          onclick="likePost('${escapeHtml(post.id)}')"
          class="${liked ? "liked" : ""}"
        >
          ♡ ${post.likes?.length || 0}
        </button>

        <button
          onclick="focusComment('${escapeHtml(post.id)}')"
        >
          ◯ ${comments.length}
        </button>

        <button
          onclick="sharePost('${escapeHtml(post.id)}')"
        >
          ↗
        </button>

      </div>

      ${
        comments.length
          ? `
            <div class="comments">
              ${comments
                .slice(-3)
                .map(c => `
                  <div class="comment">
                    <strong>@${escapeHtml(c.from)}</strong>
                    ${escapeHtml(c.text)}
                  </div>
                `)
                .join("")}
            </div>
          `
          : ""
      }

      <div class="comment-box">

        <input
          id="comment-${escapeHtml(post.id)}"
          placeholder="Ajouter un commentaire..."
          onkeydown="commentKey(event,'${escapeHtml(post.id)}')"
        >

      </div>

    </article>
  `;
}

window.likePost = async id => {
  try {
    await api(
      "/api/posts/" +
      encodeURIComponent(id) +
      "/like",
      {
        method: "POST"
      }
    );

    loadFeed();
  } catch (error) {
    toast(error.message);
  }
};

window.focusComment = id => {
  const input = $("comment-" + id);

  if (input) input.focus();
};

window.commentKey = async (event, id) => {
  if (event.key !== "Enter") return;

  const input = $("comment-" + id);
  const text = input.value.trim();

  if (!text) return;

  try {
    await api(
      "/api/posts/" +
      encodeURIComponent(id) +
      "/comments",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ text })
      }
    );

    loadFeed();
  } catch (error) {
    toast(error.message);
  }
};

window.sharePost = id => {
  toast("Publication prête à être partagée.");
};

async function publishPost() {
  const text =
    $("postText").value.trim();

  if (!text && !selectedPostFile) {
    toast("Ajoute du texte ou un fichier.");
    return;
  }

  try {
    const form = new FormData();

    form.append("text", text);

    if (selectedPostFile) {
      form.append(
        "attachment",
        selectedPostFile
      );
    }

    await api("/api/posts", {
      method: "POST",
      body: form
    });

    $("postText").value = "";
    $("postPreview").textContent = "";
    selectedPostFile = null;

    $("postModal").classList.add("hidden");

    await loadFeed();

    toast("Publication créée.");
  } catch (error) {
    toast(error.message);
  }
}

async function loadStories() {
  try {
    const stories =
      await api("/api/stories");

    const container =
      $("stories");

    container.innerHTML = `
      <button class="story-card add-story"
        onclick="document.getElementById('storyModal').classList.remove('hidden')">

        <div class="story-plus">+</div>

        <span>Ma story</span>

      </button>
    `;

    stories
      .slice(0, 12)
      .forEach(story => {
        container.insertAdjacentHTML(
          "beforeend",
          storyCardHtml(story)
        );
      });

  } catch (error) {
    console.error(error);
  }
}

async function loadStoriesFull() {
  try {
    const stories =
      await api("/api/stories");

    $("storiesFull").innerHTML = "";

    if (!stories.length) {
      $("storiesFull").innerHTML = `
        <div class="empty">
          <div class="empty-icon">◉</div>
          <h3>Aucune story</h3>
          <p>Ajoute ta première story.</p>
        </div>
      `;
      return;
    }

    stories.forEach(story => {
      $("storiesFull").insertAdjacentHTML(
        "beforeend",
        storyLargeHtml(story)
      );
    });

  } catch (error) {
    toast(error.message);
  }
}



async function deleteStory(storyId) {
  if (!storyId) return;

  const ok = window.confirm(
    "Supprimer définitivement cette story ?"
  );

  if (!ok) return;

  try {
    const response = await fetch(
      `/api/stories/${encodeURIComponent(storyId)}`,
      {
        method: "DELETE",
        credentials: "include"
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(
        data.error || "Impossible de supprimer la story."
      );
    }

    if (typeof showToast === "function") {
      showToast("Story supprimée définitivement.");
    }

    // Retire immédiatement la carte de l'écran.
    document
      .querySelectorAll(
        `[data-story-id="${CSS.escape(String(storyId))}"]`
      )
      .forEach(element => element.remove());

    // Recharge les stories si la fonction existe.
    if (typeof loadStories === "function") {
      await loadStories();
    }

  } catch (error) {
    console.error("Suppression story:", error);

    if (typeof showToast === "function") {
      showToast(error.message || "Erreur de suppression.");
    } else {
      alert(error.message || "Erreur de suppression.");
    }
  }
}

function storyCardHtml(story) {
  story = story || {};

  const username = String(
    story.username ??
    story.pseudo ??
    story.user ??
    story.author?.username ??
    story.author?.pseudo ??
    "Utilisateur"
  );

  const initial = username.charAt(0).toUpperCase() || "U";

  const storyId = String(
    story.id ??
    story._id ??
    ""
  );

  const image = String(
    story.url ??
    story.image ??
    story.imageUrl ??
    story.fileUrl ??
    story.filename ??
    ""
  );

  const caption = String(
    story.caption ??
    story.text ??
    story.content ??
    ""
  );

  const currentUser = String(
    window.currentUser?.username ??
    window.currentUser?.pseudo ??
    window.me?.username ??
    ""
  );

  const isMine =
    story.isMine === true ||
    story.owner === true ||
    (currentUser && username === currentUser);

  const safe = value =>
    String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  const safeId = safe(storyId);
  const safeUsername = safe(username);
  const safeCaption = safe(caption);

  return `
    <article class="story-card" data-story-id="${safeId}">
      <div class="story-avatar">
        ${
          image
            ? `<img src="${safe(image)}" alt="${safeUsername}" loading="lazy">`
            : `<span>${safe(initial)}</span>`
        }
      </div>

      <div class="story-card-info">
        <strong>${safeUsername}</strong>
        ${
          caption
            ? `<span>${safeCaption}</span>`
            : `<span>Story</span>`
        }
      </div>

      ${
        isMine && storyId
          ? `
            <button
              class="story-delete-btn"
              type="button"
              title="Supprimer cette story"
              aria-label="Supprimer cette story"
              onclick="deleteStory('${safeId}')"
            >🗑️</button>
          `
          : ""
      }
    </article>
  `;
}


function storyLargeHtml(story) {
  const image =
    story.attachment &&
    story.attachment.type &&
    story.attachment.type.startsWith("image/");

  return `
    <article class="story-large">

      ${
        image
          ? `
            <img
              src="${escapeHtml(story.attachment.url)}"
              alt=""
            >
          `
          : `
            <div class="story-large-placeholder">
              ${escapeHtml(story.text || "Story")}
            </div>
          `
      }

      <div class="story-overlay">

        <strong>
          @${escapeHtml(story.from)}
        </strong>

        ${
          story.text
            ? `
              <p>
                ${escapeHtml(story.text)}
              </p>
            `
            : ""
        }

      </div>

    </article>
  `;
}


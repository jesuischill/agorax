<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"
  >

  <meta name="theme-color" content="#050507">

  <title>Agorex</title>

  <link rel="icon" href="/favicon.svg">

  <link rel="stylesheet" href="/style.css">
</head>

<body>

<div id="app">

  <!-- ================================================= -->
  <!-- SIDEBAR DESKTOP -->
  <!-- ================================================= -->

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-logo">A</div>
      <span>Agorex</span>
    </div>

    <nav class="main-nav">

      <button class="nav-item active" data-view="home">
        <span class="nav-icon">⌂</span>
        <span>Accueil</span>
      </button>

      <button class="nav-item" data-view="messages">
        <span class="nav-icon">💬</span>
        <span>Messages</span>
        <span id="messageBadge" class="nav-badge hidden">0</span>
      </button>

      <button class="nav-item" data-view="explore">
        <span class="nav-icon">⌕</span>
        <span>Explorer</span>
      </button>

      <button class="nav-item" data-view="notifications">
        <span class="nav-icon">♡</span>
        <span>Notifications</span>
        <span id="notificationBadge" class="nav-badge hidden">0</span>
      </button>

      <button class="nav-item" data-view="profile">
        <span class="nav-icon">◎</span>
        <span>Mon profil</span>
      </button>

    </nav>

    <button id="createButton" class="create-button">
      <span>＋</span>
      <span>Créer</span>
    </button>

    <div class="sidebar-bottom">

      <button id="logoutButton" class="nav-item logout">
        <span class="nav-icon">↪</span>
        <span>Déconnexion</span>
      </button>

    </div>

  </aside>


  <!-- ================================================= -->
  <!-- CONTENU PRINCIPAL -->
  <!-- ================================================= -->

  <main class="main">

    <!-- TOPBAR -->

    <header class="topbar">

      <div class="mobile-brand">
        <div class="brand-logo">A</div>
        <strong>Agorex</strong>
      </div>

      <div class="top-search">
        <span>⌕</span>
        <input
          id="globalSearch"
          type="search"
          placeholder="Rechercher sur Agorex..."
          autocomplete="off"
        >
      </div>

      <div class="top-actions">

        <button
          id="topMessages"
          class="icon-button"
          title="Messages"
        >
          💬
        </button>

        <button
          id="topNotifications"
          class="icon-button"
          title="Notifications"
        >
          ♡
        </button>

        <button
          id="topProfile"
          class="avatar-button"
          title="Profil"
        >
          <img id="topAvatar" src="" alt="">
        </button>

      </div>

    </header>


    <!-- ================================================= -->
    <!-- VUES -->
    <!-- ================================================= -->

    <section id="viewHome" class="view active-view">

      <div class="home-layout">

        <div class="feed-column">

          <!-- STORIES -->

          <section class="stories-panel">

            <div class="section-title-row">
              <div>
                <h2>Stories</h2>
                <span>Ce qui se passe maintenant</span>
              </div>

              <button id="allStoriesButton" class="small-button">
                Voir tout
              </button>
            </div>

            <div id="stories" class="stories"></div>

          </section>


          <!-- CREATE POST -->

          <section class="composer">

            <div class="composer-top">

              <img
                id="composerAvatar"
                class="avatar"
                src=""
                alt=""
              >

              <button id="composerInput" class="composer-placeholder">
                Quoi de neuf ?
              </button>

            </div>

            <div class="composer-actions">

              <button id="photoPostButton">
                📷 Photo
              </button>

              <button id="storyPostButton">
                ✨ Story
              </button>

              <button id="textPostButton">
                ✍ Publication
              </button>

            </div>

          </section>


          <!-- FEED -->

          <section>

            <div class="section-title-row feed-heading">

              <div>
                <h2>Fil Agorex</h2>
                <span>Les dernières publications</span>
              </div>

              <button id="refreshFeed" class="small-button">
                ↻
              </button>

            </div>

            <div id="feed" class="feed"></div>

          </section>

        </div>


        <!-- RIGHT COLUMN -->

        <aside class="right-column">

          <section class="quick-profile">

            <div class="quick-profile-head">

              <img id="quickAvatar" class="large-avatar" src="" alt="">

              <div>
                <strong id="quickName">Utilisateur</strong>
                <span id="quickUsername">@utilisateur</span>
              </div>

            </div>

            <button
              id="quickProfileButton"
              class="outline-button full"
            >
              Voir mon profil
            </button>

          </section>


          <section class="quick-messages">

            <div class="section-title-row">

              <div>
                <h3>Messages</h3>
                <span>Conversations récentes</span>
              </div>

              <button
                class="text-button"
                data-view="messages"
              >
                Voir
              </button>

            </div>

            <div id="quickConversations"></div>

          </section>

        </aside>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- MESSAGES -->
    <!-- ================================================= -->

    <section id="viewMessages" class="view">

      <div class="messages-layout">

        <!-- LISTE DES CONVERSATIONS -->

        <aside class="conversation-list">

          <div class="messages-header">

            <div>
              <h1>Messages</h1>
              <span>Toutes tes discussions au même endroit</span>
            </div>

            <button
              id="newConversationButton"
              class="round-button"
            >
              ＋
            </button>

          </div>

          <div class="conversation-search">

            <span>⌕</span>

            <input
              id="conversationSearch"
              placeholder="Rechercher une conversation"
            >

          </div>


          <!-- PUBLIC EST UNE CONVERSATION -->
          <button
            id="publicConversation"
            class="conversation public-conversation active"
          >

            <div class="conversation-avatar public-avatar">
              🌎
            </div>

            <div class="conversation-info">

              <strong>Agorex Public</strong>

              <span id="publicPreview">
                Salon public
              </span>

            </div>

            <span class="online-dot"></span>

          </button>


          <div id="conversationList"></div>

        </aside>


        <!-- FENÊTRE CHAT -->

        <section class="chat-window">

          <header class="chat-header">

            <div class="chat-person">

              <div id="chatAvatar" class="chat-avatar">
                🌎
              </div>

              <div>

                <strong id="chatTitle">
                  Agorex Public
                </strong>

                <span id="chatStatus">
                  Salon public
                </span>

              </div>

            </div>

            <div class="chat-header-actions">

              <button id="chatSearchButton">⌕</button>
              <button id="chatMoreButton">•••</button>

            </div>

          </header>


          <div
            id="typingIndicator"
            class="typing-indicator hidden"
          >
            quelqu'un écrit...
          </div>


          <div
            id="chatMessages"
            class="chat-messages"
          ></div>


          <form id="messageForm" class="message-composer">

            <button
              type="button"
              id="attachButton"
              class="composer-icon"
            >
              ＋
            </button>

            <input
              id="messageInput"
              autocomplete="off"
              maxlength="2000"
              placeholder="Écrire un message..."
            >

            <button
              type="button"
              id="emojiButton"
              class="composer-icon"
            >
              ☺
            </button>

            <button
              type="submit"
              class="send-button"
            >
              ➤
            </button>

          </form>

        </section>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- EXPLORER -->
    <!-- ================================================= -->

    <section id="viewExplore" class="view">

      <div class="page-header">

        <h1>Explorer</h1>

        <span>
          Découvre les utilisateurs et les publications d'Agorex.
        </span>

      </div>

      <div id="searchResults" class="search-results">

        <div class="empty-state">
          <div>⌕</div>
          <h2>Recherche quelqu'un</h2>
          <p>
            Utilise la barre de recherche pour trouver des utilisateurs.
          </p>
        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- NOTIFICATIONS -->
    <!-- ================================================= -->

    <section id="viewNotifications" class="view">

      <div class="page-header">

        <h1>Notifications</h1>

        <span>
          Les interactions avec ton compte.
        </span>

      </div>

      <div id="notifications" class="notifications"></div>

    </section>


    <!-- ================================================= -->
    <!-- PROFIL -->
    <!-- ================================================= -->

    <section id="viewProfile" class="view">

      <div id="profilePage" class="profile-page"></div>

    </section>

  </main>


  <!-- ================================================= -->
  <!-- MOBILE NAV -->
  <!-- ================================================= -->

  <nav class="mobile-nav">

    <button data-view="home">
      <span>⌂</span>
      <small>Accueil</small>
    </button>

    <button data-view="explore">
      <span>⌕</span>
      <small>Explorer</small>
    </button>

    <button id="mobileCreate">
      <span class="mobile-create">＋</span>
      <small>Créer</small>
    </button>

    <button data-view="messages">
      <span>💬</span>
      <small>Messages</small>
    </button>

    <button data-view="profile">
      <span>◎</span>
      <small>Profil</small>
    </button>

  </nav>


  <!-- ================================================= -->
  <!-- MODALE CRÉATION -->
  <!-- ================================================= -->

  <div id="createModal" class="modal hidden">

    <div class="modal-backdrop"></div>

    <div class="modal-card">

      <button class="modal-close" id="closeCreateModal">
        ×
      </button>

      <h2>Créer sur Agorex</h2>

      <p>
        Partage quelque chose avec la communauté.
      </p>

      <div class="create-options">

        <button id="createText">
          <span>✍</span>
          <strong>Publication</strong>
          <small>Partager un texte</small>
        </button>

        <button id="createPhoto">
          <span>📷</span>
          <strong>Photo</strong>
          <small>Publier une image</small>
        </button>

        <button id="createStory">
          <span>✨</span>
          <strong>Story</strong>
          <small>Visible pendant 24 h</small>
        </button>

      </div>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- MODALE PUBLICATION -->
  <!-- ================================================= -->

  <div id="postModal" class="modal hidden">

    <div class="modal-backdrop"></div>

    <div class="modal-card post-modal">

      <button class="modal-close" id="closePostModal">
        ×
      </button>

      <h2>Nouvelle publication</h2>

      <textarea
        id="postText"
        maxlength="5000"
        placeholder="Quoi de neuf ?"
      ></textarea>

      <input
        id="postImage"
        type="file"
        accept="image/*"
      >

      <button id="publishButton" class="primary-button">
        Publier
      </button>

    </div>

  </div>


  <!-- TOAST -->

  <div id="toast" class="toast hidden"></div>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/app.js"></script>

</body>
</html>

/* =========================================================
   POSTS
   ========================================================= */

function openPostModal() {
  $("postModal")?.classList.remove("hidden");
}

function closePostModal() {
  $("postModal")?.classList.add("hidden");

  if ($("postText")) {
    $("postText").value = "";
  }

  if ($("postImage")) {
    $("postImage").value = "";
  }
}

async function createPost() {
  const text = $("postText")?.value.trim();
  const file = $("postImage")?.files?.[0];

  if (!text && !file) {
    showToast("Ajoute du texte ou une image.");
    return;
  }

  const form = new FormData();

  if (text) {
    form.append("content", text);
    form.append("text", text);
  }

  if (file) {
    form.append("image", file);
  }

  try {
    await api("/api/posts", {
      method: "POST",
      body: form
    });

    closePostModal();

    showToast("Publication créée ✓");

    await loadFeed();

  } catch (error) {
    showToast(error.message);
  }
}


/* =========================================================
   CONVERSATIONS
   ========================================================= */

async function loadConversations() {
  try {
    const data = await api(
      "/api/messages/conversations"
    );

    state.conversations =
      Array.isArray(data)
        ? data
        : data.conversations || [];

  } catch {
    state.conversations = [];
  }

  renderConversations();
  renderQuickConversations();
}

function renderConversations() {
  const container = $("conversationList");

  if (!container) return;

  container.innerHTML =
    state.conversations.map(conversation => {

      const user =
        conversation.user ||
        conversation.otherUser ||
        conversation;

      const username =
        conversation.username ||
        usernameOf(user);

      const avatar =
        conversation.avatar ||
        avatarUrl(user);

      const preview =
        conversation.lastMessage ||
        conversation.preview ||
        "Aucun message";

      return `
        <button
          class="conversation"
          data-private-user="${escapeHtml(username)}"
        >

          <div class="conversation-avatar">
            <img
              src="${escapeHtml(avatar)}"
              alt=""
            >
          </div>

          <div class="conversation-info">

            <strong>
              ${escapeHtml(
                conversation.displayName ||
                username
              )}
            </strong>

            <span>
              ${escapeHtml(preview)}
            </span>

          </div>

          <span
            class="online-dot"
            data-online="${escapeHtml(username)}"
          ></span>

        </button>
      `;
    }).join("");
}

function renderQuickConversations() {
  const container = $("quickConversations");

  if (!container) return;

  if (!state.conversations.length) {
    container.innerHTML = `
      <div class="empty-state" style="padding:30px 5px">
        <p>Aucune conversation privée.</p>
      </div>
    `;
    return;
  }

  container.innerHTML =
    state.conversations
      .slice(0,4)
      .map(conversation => {

        const username =
          conversation.username ||
          conversation.user?.username ||
          conversation.otherUser?.username ||
          "Utilisateur";

        const avatar =
          conversation.avatar ||
          conversation.user?.avatar ||
          conversation.otherUser?.avatar ||
          "/favicon.svg";

        return `
          <button
            class="conversation"
            data-private-user="${escapeHtml(username)}"
          >

            <div class="conversation-avatar">
              <img src="${escapeHtml(avatar)}">
            </div>

            <div class="conversation-info">
              <strong>@${escapeHtml(username)}</strong>
              <span>
                ${escapeHtml(
                  conversation.lastMessage ||
                  "Discussion"
                )}
              </span>
            </div>

          </button>
        `;
      })
      .join("");
}


/* =========================================================
   CHAT
   ========================================================= */

function openPublicChat() {
  state.currentChat = "public";
  state.currentChatUser = null;

  $("publicConversation")?.classList.add("active");

  document.querySelectorAll(
    "[data-private-user]"
  ).forEach(el => {
    el.classList.remove("active");
  });

  $("chatTitle").textContent = "Agorex Public";
  $("chatStatus").textContent =
    "Tout le monde peut participer";

  $("chatAvatar").innerHTML = "🌎";

  renderPublicMessages();

  $("messageInput").placeholder =
    "Écrire dans le salon public...";

  $("messageInput")?.focus();
}

async function openPrivateChat(username) {
  state.currentChat = "private";
  state.currentChatUser = username;

  $("publicConversation")?.classList.remove("active");

  document.querySelectorAll(
    "[data-private-user]"
  ).forEach(el => {
    el.classList.toggle(
      "active",
      el.dataset.privateUser === username
    );
  });

  let user = null;

  try {
    const data = await api(
      "/api/profile/" +
      encodeURIComponent(username)
    );

    user = data.user || data;

  } catch {
    user = {
      username
    };
  }

  $("chatTitle").textContent =
    user.displayName ||
    user.username ||
    "Utilisateur";

  $("chatStatus").textContent =
    state.onlineUsers[username]
      ? "En ligne"
      : "Hors ligne";

  $("chatAvatar").innerHTML = `
    <img src="${escapeHtml(
      avatarUrl(user)
    )}">
  `;

  $("messageInput").placeholder =
    "Écrire un message privé...";

  await loadPrivateMessages(username);

  $("messageInput")?.focus();
}

async function loadPrivateMessages(username) {
  try {
    const data = await api(
      "/api/messages/" +
      encodeURIComponent(username)
    );

    state.privateMessages[username] =
      Array.isArray(data)
        ? data
        : data.messages || [];

  } catch {
    state.privateMessages[username] =
      state.privateMessages[username] || [];
  }

  renderPrivateMessages(username);
}

function renderPublicMessages() {
  const container = $("chatMessages");

  if (!container) return;

  container.innerHTML =
    state.publicMessages.map(message => {

      const username =
        message.username ||
        message.from ||
        message.sender ||
        "Utilisateur";

      const mine =
        username === state.me?.username;

      return `
        <div class="message-row ${mine ? "me" : "them"}">

          <div class="message-bubble">

            ${
              !mine
                ? `
                  <div class="message-sender">
                    @${escapeHtml(username)}
                  </div>
                `
                : ""
            }

            <div>
              ${escapeHtml(
                message.message ||
                message.text ||
                ""
              )}
            </div>

            <div class="message-meta">
              ${escapeHtml(
                formatTime(
                  message.createdAt ||
                  message.timestamp ||
                  Date.now()
                )
              )}
            </div>

          </div>

        </div>
      `;
    }).join("");

  container.scrollTop =
    container.scrollHeight;
}

function renderPrivateMessages(username) {
  const container = $("chatMessages");

  if (!container) return;

  const messages =
    state.privateMessages[username] || [];

  container.innerHTML =
    messages.map(message => {

      const from =
        message.from ||
        message.username ||
        message.sender;

      const mine =
        from === state.me?.username;

      return `
        <div class="message-row ${mine ? "me" : "them"}">

          <div class="message-bubble">

            <div>
              ${escapeHtml(
                message.message ||
                message.text ||
                ""
              )}
            </div>

            <div class="message-meta">
              ${escapeHtml(
                formatTime(
                  message.createdAt ||
                  message.timestamp ||
                  Date.now()
                )
              )}
            </div>

          </div>

        </div>
      `;
    }).join("");

  container.scrollTop =
    container.scrollHeight;
}

function sendMessage(text) {
  text = String(text || "").trim();

  if (!text || !state.me) return;

  if (state.currentChat === "public") {

    socket.emit(
      "publicMessage",
      text
    );

    return;
  }

  if (
    state.currentChat === "private" &&
    state.currentChatUser
  ) {

    socket.emit(
      "privateMessage",
      {
        to: state.currentChatUser,
        message: text
      }
    );
  }
}


/* =========================================================
   SOCKET.IO
   ========================================================= */

socket.on("connect", () => {

  if (!state.me) return;

  socket.emit("joinPublic", {
    username: state.me.username
  });

  socket.emit("presence", {
    username: state.me.username
  });

});


socket.on("publicHistory", messages => {

  state.publicMessages =
    Array.isArray(messages)
      ? messages
      : [];

  if (state.currentChat === "public") {
    renderPublicMessages();
  }

});


socket.on("publicMessage", message => {

  state.publicMessages.push(message);

  if (state.publicMessages.length > 300) {
    state.publicMessages.shift();
  }

  if (state.currentChat === "public") {
    renderPublicMessages();
  }

  const preview = $("publicPreview");

  if (preview) {
    preview.textContent =
      "@" +
      (
        message.username ||
        "Utilisateur"
      ) +
      " : " +
      (
        message.message ||
        ""
      ).slice(0,35);
  }

});


socket.on("privateMessage", message => {

  const from =
    message.from ||
    message.username ||
    message.sender;

  const to =
    message.to ||
    message.recipient;

  const other =
    from === state.me?.username
      ? to
      : from;

  if (!other) return;

  if (!state.privateMessages[other]) {
    state.privateMessages[other] = [];
  }

  state.privateMessages[other].push(message);

  if (
    state.currentChat === "private" &&
    state.currentChatUser === other
  ) {
    renderPrivateMessages(other);
  }

  loadConversations();

});


socket.on("presence", data => {

  if (!data) return;

  const username =
    data.username ||
    data.user;

  if (!username) return;

  state.onlineUsers[username] =
    data.online !== false;

  document.querySelectorAll(
    `[data-online="${CSS.escape(username)}"]`
  ).forEach(el => {
    el.style.opacity =
      data.online === false
        ? ".2"
        : "1";
  });

  if (
    state.currentChat === "private" &&
    state.currentChatUser === username
  ) {
    $("chatStatus").textContent =
      data.online === false
        ? "Hors ligne"
        : "En ligne";
  }

});


socket.on("typing", data => {

  if (!data) return;

  if (
    state.currentChat === "private" &&
    data.username === state.currentChatUser
  ) {

    $("typingIndicator")
      ?.classList
      .toggle(
        "hidden",
        !data.typing
      );
  }

});


/* =========================================================
   MESSAGE FORM
   ========================================================= */

$("messageForm")?.addEventListener(
  "submit",
  event => {

    event.preventDefault();

    const input = $("messageInput");

    if (!input) return;

    const text = input.value.trim();

    if (!text) return;

    sendMessage(text);

    input.value = "";

    input.focus();
  }
);


$("messageInput")?.addEventListener(
  "input",
  () => {

    if (
      state.currentChat !== "private" ||
      !state.currentChatUser
    ) {
      return;
    }

    socket.emit(
      "typing",
      {
        to: state.currentChatUser,
        typing:
          $("messageInput").value.length > 0
      }
    );
  }
);



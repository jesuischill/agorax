"use strict";

/* =========================================================
   AGOREX SOCIAL APP
   Feed + Stories + Public chat + Private messages
   ========================================================= */

const socket = io();

const state = {
  me: null,
  currentView: "home",
  currentChat: "public",
  currentChatUser: null,
  conversations: [],
  publicMessages: [],
  privateMessages: {},
  onlineUsers: {},
  typingUsers: {},
  feed: [],
  stories: [],
  notifications: [],
  searchTimer: null
};


/* =========================================================
   HELPERS
   ========================================================= */

const $ = id => document.getElementById(id);

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function avatarUrl(user) {
  if (!user) return "/favicon.svg";

  return (
    user.avatar ||
    user.avatarUrl ||
    "/favicon.svg"
  );
}

function usernameOf(user) {
  return user?.username || user?.name || "Utilisateur";
}

function formatTime(date) {
  try {
    return new Date(date).toLocaleTimeString("fr-FR", {
      hour: "2-digit",
      minute: "2-digit"
    });
  } catch {
    return "";
  }
}

function showToast(message) {
  const el = $("toast");

  if (!el) return;

  el.textContent = message;
  el.classList.remove("hidden");

  clearTimeout(showToast.timer);

  showToast.timer = setTimeout(() => {
    el.classList.add("hidden");
  }, 2800);
}

async function api(url, options = {}) {
  const response = await fetch(url, {
    credentials: "include",
    ...options
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(data.error || "Erreur serveur");
  }

  return data;
}


/* =========================================================
   AUTH
   ========================================================= */

async function loadMe() {
  try {
    const data = await api("/api/auth/me");

    state.me = data.user || data;

    if (!state.me) {
      window.location.href = "/login.html";
      return false;
    }

    updateUserUI();

    return true;
  } catch {
    window.location.href = "/login.html";
    return false;
  }
}

function updateUserUI() {
  if (!state.me) return;

  const avatar = avatarUrl(state.me);
  const username = usernameOf(state.me);

  [
    $("topAvatar"),
    $("composerAvatar"),
    $("quickAvatar")
  ].forEach(el => {
    if (el) el.src = avatar;
  });

  if ($("quickName")) {
    $("quickName").textContent =
      state.me.displayName ||
      state.me.username ||
      "Utilisateur";
  }

  if ($("quickUsername")) {
    $("quickUsername").textContent =
      "@" + username;
  }
}


/* =========================================================
   NAVIGATION
   ========================================================= */

function switchView(view) {
  state.currentView = view;

  document.querySelectorAll(".view").forEach(el => {
    el.classList.remove("active-view");
  });

  const target = {
    home: "viewHome",
    messages: "viewMessages",
    explore: "viewExplore",
    notifications: "viewNotifications",
    profile: "viewProfile"
  }[view];

  if ($(target)) {
    $(target).classList.add("active-view");
  }

  document.querySelectorAll("[data-view]").forEach(button => {
    button.classList.toggle(
      "active",
      button.dataset.view === view
    );
  });

  if (view === "home") {
    loadFeed();
    loadStories();
  }

  if (view === "messages") {
    loadConversations();
  }

  if (view === "notifications") {
    loadNotifications();
  }

  if (view === "profile") {
    loadProfile();
  }

  if (view === "explore") {
    $("globalSearch")?.focus();
  }
}

document.addEventListener("click", event => {
  const button = event.target.closest("[data-view]");

  if (button) {
    switchView(button.dataset.view);
  }
});


/* =========================================================
   FEED
   ========================================================= */

async function loadFeed() {
  try {
    const data = await api("/api/feed");

    state.feed =
      Array.isArray(data)
        ? data
        : data.posts || [];

    renderFeed();
  } catch (error) {
    console.error(error);
    $("feed").innerHTML = `
      <div class="empty-state">
        <div>⚠</div>
        <h2>Impossible de charger le fil</h2>
        <p>${escapeHtml(error.message)}</p>
      </div>
    `;
  }
}

function renderFeed() {
  const feed = $("feed");

  if (!feed) return;

  if (!state.feed.length) {
    feed.innerHTML = `
      <div class="empty-state">
        <div>✨</div>
        <h2>Bienvenue sur Agorex</h2>
        <p>
          Les premières publications apparaîtront ici.
        </p>
      </div>
    `;
    return;
  }

  feed.innerHTML = state.feed.map(post => {

    const user =
      post.user ||
      post.author ||
      {
        username: post.username,
        avatar: post.avatar
      };

    const username =
      post.username ||
      usernameOf(user);

    const avatar =
      post.avatar ||
      avatarUrl(user);

    const text =
      post.content ||
      post.text ||
      "";

    const image =
      post.image ||
      post.imageUrl ||
      "";

    const likes =
      Number(post.likesCount ?? post.likes?.length ?? 0);

    return `
      <article class="post">

        <div class="post-header">

          <img
            src="${escapeHtml(avatar)}"
            alt=""
          >

          <div class="post-user">
            <strong>
              ${escapeHtml(
                post.displayName ||
                username
              )}
            </strong>

            <span>
              @${escapeHtml(username)}
              · ${escapeHtml(
                formatTime(post.createdAt || Date.now())
              )}
            </span>
          </div>

        </div>

        ${
          text
            ? `
              <div class="post-content">
                ${escapeHtml(text)}
              </div>
            `
            : ""
        }

        ${
          image
            ? `
              <img
                class="post-image"
                src="${escapeHtml(image)}"
                alt="Publication"
                loading="lazy"
              >
            `
            : ""
        }

        <div class="post-actions">

          <button
            data-like-post="${escapeHtml(post.id || "")}"
          >
            ♡ ${likes}
          </button>

          <button
            data-comment-post="${escapeHtml(post.id || "")}"
          >
            💬 Commenter
          </button>

          <button
            data-share-post="${escapeHtml(post.id || "")}"
          >
            ↗ Partager
          </button>

        </div>

      </article>
    `;
  }).join("");
}


/* =========================================================
   STORIES

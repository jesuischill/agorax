/* =========================================================
   INITIALISATION
   ========================================================= */

(async function init() {

  const authenticated =
    await loadMe();

  if (!authenticated) {
    return;
  }

  switchView("home");

  await Promise.all([
    loadFeed(),
    loadStories(),
    loadConversations()
  ]);

  openPublicChat();

})();

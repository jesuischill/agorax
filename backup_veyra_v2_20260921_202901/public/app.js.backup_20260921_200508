/* =========================================================
   SEARCH
   ========================================================= */

async function searchUsers(query) {

  query = String(query || "").trim();

  if (!query) {
    $("searchResults").innerHTML = `
      <div class="empty-state">
        <div>⌕</div>
        <h2>Recherche quelqu'un</h2>
        <p>
          Utilise la barre de recherche pour trouver des utilisateurs.
        </p>
      </div>
    `;
    return;
  }

  try {

    const data = await api(
      "/api/search?q=" +
      encodeURIComponent(query)
    );

    const results =
      Array.isArray(data)
        ? data
        : data.users || data.results || [];

    renderSearchResults(results);

  } catch (error) {

    showToast(error.message);

  }
}

function renderSearchResults(results) {

  const container =
    $("searchResults");

  if (!container) return;

  if (!results.length) {

    container.innerHTML = `
      <div class="empty-state">
        <div>⌕</div>
        <h2>Aucun résultat</h2>
        <p>
          Aucun utilisateur trouvé.
        </p>
      </div>
    `;

    return;
  }

  container.innerHTML =
    results.map(user => {

      const username =
        usernameOf(user);

      return `
        <div class="search-user">

          <img
            src="${escapeHtml(
              avatarUrl(user)
            )}"
            alt=""
          >

          <div class="search-user-info">

            <strong>
              ${escapeHtml(
                user.displayName ||
                username
              )}
            </strong>

            <span>
              @${escapeHtml(username)}
            </span>

          </div>

          <button
            class="outline-button"
            data-message-user="${escapeHtml(username)}"
          >
            💬
          </button>

        </div>
      `;
    }).join("");
}


